# Google Tag Manager MCP - Configuración de Credenciales
# Obtén tus credenciales OAuth 2.0 (Client ID y Client Secret) desde Google Cloud Console
# Genera tu Refresh Token autorizando la API de Tag Manager (tagmanager v2)

# OAuth 2.0 Client ID de Google Cloud
GTM_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# OAuth 2.0 Client Secret de Google Cloud
GTM_CLIENT_SECRET=tu-client-secret-aqui

# Refresh Token obtenido tras la autorización inicial
GTM_REFRESH_TOKEN=tu-refresh-token-aqui

# (Opcional) ID de cuenta y contenedor por defecto para llamadas abreviadas
# GTM_DEFAULT_ACCOUNT_ID=1234567890
# GTM_DEFAULT_CONTAINER_ID=GTM-XXXXXXX
