{
  "name": "google-tag-manager-mcp",
  "version": "1.0.0",
  "description": "Servidor MCP (Model Context Protocol) en TypeScript para auditar, automatizar y gestionar Google Tag Manager (Web y Server-Side) con arquitectura segura STDIO y OAuth2.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "google-tag-manager-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-tag-manager",
    "gtm",
    "analytics",
    "antigravity",
    "tracking",
    "cybersecurity"
  ],
  "author": "Ramiro Medina <contacto@asoaisolutions.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "dotenv": "^16.4.7",
    "googleapis": "^144.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "typescript": "^5.7.3"
  }
}
